{
  "name": "pipedact-sample-app",
  "version": "1.0.0",
  "description": "Sample application demonstrating PIPEDA & SOC 2 compliance anti-patterns and auditing with pipedact",
  "main": "src/server.ts",
  "scripts": {
    "lint:pipeda": "pipedact check . --framework pipeda --strict",
    "lint:soc2": "pipedact check . --framework soc2 --strict",
    "lint:all": "pipedact check . --framework all",
    "dossier:pipeda": "pipedact dossier --framework pipeda --format markdown --out PIPEDA_DOSSIER.md",
    "dossier:soc2": "pipedact dossier --framework soc2 --format markdown --out SOC2_DOSSIER.md"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "@prisma/client": "^5.14.0"
  }
}
