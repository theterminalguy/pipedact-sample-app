datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// VIOLATION [Principle 5: Retention & Disposal]: Missing TTL expiration or autoPurge schedule
// VIOLATION [Principle 2: Identifying Purposes]: Missing statutory purpose declarations on sensitive fields
model UserAccount {
  id              String   @id @default(uuid())
  email           String   @unique
  canadianSIN     String   // High risk identifier without lawful purpose tag
  creditCardToken String   // Financial identifier without purpose or retention declaration
  medicalNotes    String?  // Health data collected without classification
  createdAt       DateTime @default(now())
}
